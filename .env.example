# Copy to .env locally if desired. Cursor mcp.json can also set these under "env".
# Keep in sync with Settings fields in config.py as defaults change.

IBMI_DOCS_VERSION=7.5.0
IBMI_DOCS_CACHE_PATH=~/.cache/ibmi-docs-mcp/docs_cache.db
IBMI_DOCS_TTL_DAYS=30
IBMI_DOCS_MAX_CHARS=12000
IBMI_DOCS_HTTP_TIMEOUT=20
IBMI_DOCS_MAX_RETRIES=3
IBMI_DOCS_MAX_CONCURRENCY=2
IBMI_DOCS_USER_AGENT=ibmi-docs-mcp/0.1 (+local-agent)
IBMI_DOCS_BASE_URL=https://www.ibm.com
IBMI_DOCS_LOG_LEVEL=INFO
